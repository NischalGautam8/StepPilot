# ==============================================================================
# StepPilot (Cursor-King) Environment Configuration Template
# Duplicate this file as '.env' and fill in your credential values.
# ==============================================================================

# LLM Providers Configuration
# Required for fallback / standard OpenAI API execution:
OPENAI_API_KEY=your_openai_key_here

# Required for primary GitHub Copilot SDK integration:
GITHUB_TOKEN=your_github_token_here

# Application Configuration (Optional overrides)
# BACKEND_PORT=8765
# DEBUG_MODE=true
